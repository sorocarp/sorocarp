# Which market source feeds the organism: mock | dexscreener
PHYSARUM_MARKET_SOURCE=mock

# Port for the live visualisation server
PORT=4242

# Optional: comma-separated Solana token mint addresses for the dexscreener source.
# Overrides market.solana.tokens in config/default.json.
# PHYSARUM_SOLANA_TOKENS=So11111111111111111111111111111111111111112,JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN

# Optional: path to an alternative config file
# PHYSARUM_CONFIG=./config/default.json
